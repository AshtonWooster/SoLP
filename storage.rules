rules_version = '2';

// Game assets (maps, token art, handouts): members can view, only the GM can upload.
service firebase.storage {
  match /b/{bucket}/o {
    // Raster images only: an SVG can carry scripts that run if someone opens its link directly.
    function isImage() {
      return request.resource.contentType.matches("image/(png|jpeg|gif|webp|avif|bmp)");
    }
    function game(gameId) {
      return firestore.get(/databases/(default)/documents/games/$(gameId)).data;
    }

    // Each player's own images (portrait, Page art): members can view; the player (or the GM) uploads.
    match /games/{gameId}/users/{uid}/{path=**} {
      allow read: if request.auth != null && request.auth.uid in game(gameId).memberIds;
      allow write: if request.auth != null
        && ((request.auth.uid == uid && request.auth.uid in game(gameId).memberIds) || game(gameId).gmId == request.auth.uid)
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024
                && isImage()));
    }

    match /games/{gameId}/assets/{path=**} {
      allow read: if request.auth != null && request.auth.uid in game(gameId).memberIds;
      allow write: if request.auth != null && game(gameId).gmId == request.auth.uid
        && (request.resource == null
            || (request.resource.size < 25 * 1024 * 1024
                && isImage()));
    }
  }
}
