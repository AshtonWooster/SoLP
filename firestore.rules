rules_version = '2';

// Games and invite codes are only changed by the Cloud Functions in functions/src.
// During play the GM's browser hosts the table (src/net/host.ts): it alone may save the
// table, and other devices reach it through the signals collection.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function game(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId)).data;
    }
    function isMember(gameId) {
      return signedIn() && request.auth.uid in game(gameId).memberIds;
    }
    function isGm(gameId) {
      return signedIn() && game(gameId).gmId == request.auth.uid;
    }
    // The GM's hosting tab saves the table (with any running combat) every few seconds.
    function inCombat(gameId) {
      let table = /databases/$(database)/documents/games/$(gameId)/table/state;
      return exists(table) && get(table).data.get("combat", null) != null;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["displayName", "email"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 32;
    }

    match /games/{gameId} {
      // Also lets the front page list "games where memberIds contains me".
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      match /table/{doc} {
        allow read: if isMember(gameId);
        // Autosave from the GM's hosting tab.
        allow write: if doc == "state" && isGm(gameId)
          && request.resource.data.keys().hasOnly(["map", "maps", "tokens", "log", "combat"]);
      }

      // Present while a GM screen is hosting; devices watch it to know where to connect.
      match /session/{doc} {
        allow read: if isMember(gameId);
        allow write: if doc == "host" && isGm(gameId);
      }

      // Connection handshakes: a member posts an offer as themselves, only the GM answers.
      match /signals/{signalId} {
        allow create: if isMember(gameId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(["uid", "sessionId", "offer", "createdAt"])
          && request.resource.data.offer is string
          && request.resource.data.offer.size() < 20000;
        // A deleted (already answered) signal reads as empty instead of an error.
        allow read: if signedIn() && (resource == null || resource.data.uid == request.auth.uid || isGm(gameId));
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isGm(gameId));
        allow update: if isGm(gameId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["answer"])
          && request.resource.data.answer is string
          && request.resource.data.answer.size() < 20000;
      }

      // One character per player. Party members can read it (allies' public info).
      // The player edits their own; the GM can edit any and is the only one who changes Rank.
      match /characters/{uid} {
        allow read: if isMember(gameId);
        allow create: if isMember(gameId) && request.auth.uid == uid
          && request.resource.data.ownerId == uid
          && request.resource.data.rank == 9;
        // Players can't change their Combat Deck mid-combat (Act 6: edit decks while resting).
        allow update: if isGm(gameId)
          || (request.auth.uid == uid
              && request.resource.data.ownerId == uid
              && request.resource.data.rank == resource.data.rank
              && (!inCombat(gameId)
                  || request.resource.data.get("deck", null) == resource.data.get("deck", null)));
        allow delete: if isGm(gameId) || (signedIn() && request.auth.uid == uid);
      }

      // Enemy templates: only the GM sees or edits them.
      match /enemies/{templateId} {
        allow read, write: if isGm(gameId);
      }

      match /gm/meta {
        allow read: if isGm(gameId);
      }

      match /gm/notes {
        allow read: if isGm(gameId);
        allow write: if isGm(gameId)
          && request.resource.data.keys().hasOnly(["tokens"])
          && request.resource.data.tokens is map;
      }
    }
  }
}
