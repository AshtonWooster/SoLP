rules_version = '2';

// Clients may read what they're allowed to see. Games, tables and invite codes are only
// ever changed by the Cloud Functions in functions/src, which check every action.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function game(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId)).data;
    }
    function isMember(gameId) {
      return signedIn() && request.auth.uid in game(gameId).memberIds;
    }
    function isGm(gameId) {
      return signedIn() && game(gameId).gmId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["displayName", "email"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 32;
    }

    match /games/{gameId} {
      // Also lets the front page list "games where memberIds contains me".
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      match /table/{doc} {
        allow read: if isMember(gameId);
      }

      match /gm/meta {
        allow read: if isGm(gameId);
      }

      match /gm/notes {
        allow read: if isGm(gameId);
        allow write: if isGm(gameId)
          && request.resource.data.keys().hasOnly(["tokens"])
          && request.resource.data.tokens is map;
      }

      match /presence/{uid} {
        allow read: if isMember(gameId);
        allow write: if isMember(gameId) && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["lastSeen"])
          && request.resource.data.lastSeen is number;
      }
    }
  }
}
