rules_version = '2';

// Games are created and joined, and invite codes made, only by the Cloud Functions in functions/src;
// the GM can change a game's settings and remove players.
// During play the GM's browser hosts the table (src/net/host.ts): it alone may save the
// table, and other devices reach it through the signals collection.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function game(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId)).data;
    }
    function isMember(gameId) {
      return signedIn() && request.auth.uid in game(gameId).memberIds;
    }
    function isGm(gameId) {
      return signedIn() && game(gameId).gmId == request.auth.uid;
    }
    // Game settings: may players edit this part of their sheet freely? On unless the GM turned it off;
    // then their changes go in the sheet's pendingEdits for the GM to approve (shared/permissions.ts).
    function playerMayEdit(gameId, key) {
      return game(gameId).get("settings", {}).get("playerEdit", {}).get(key, true) != false;
    }
    function playersMakeItems(gameId) {
      return game(gameId).get("settings", {}).get("playersCreateItems", false) == true;
    }
    function playersMakeEffects(gameId) {
      return game(gameId).get("settings", {}).get("playersCreateEffects", false) == true;
    }
    function unchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }
    // The GM's hosting tab saves the table (with any running combat) every few seconds.
    function inCombat(gameId) {
      let table = /databases/$(database)/documents/games/$(gameId)/table/state;
      return exists(table) && get(table).data.get("combat", null) != null;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["displayName", "email"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 32;
    }

    match /games/{gameId} {
      // Also lets the front page list "games where memberIds contains me".
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      // The GM changes settings and removes players; nobody can be added this way, and the GM stays.
      allow update: if signedIn() && resource.data.gmId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["settings", "members", "memberIds"])
        && request.resource.data.memberIds.hasOnly(resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.members.keys().hasOnly(resource.data.members.keys())
        && request.resource.data.members[request.auth.uid] == resource.data.members[request.auth.uid]
        && (request.resource.data.get("settings", null) == null || request.resource.data.settings is map);

      match /table/{doc} {
        allow read: if isMember(gameId);
        // Autosave from the GM's hosting tab.
        allow write: if doc == "state" && isGm(gameId)
          && request.resource.data.keys().hasOnly(["map", "maps", "tokens", "log", "combat"]);
      }

      // Present while a GM screen is hosting; devices watch it to know where to connect.
      match /session/{doc} {
        allow read: if isMember(gameId);
        allow write: if doc == "host" && isGm(gameId);
      }

      // Connection handshakes: a member posts an offer as themselves, only the GM answers.
      match /signals/{signalId} {
        allow create: if isMember(gameId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(["uid", "sessionId", "offer", "createdAt"])
          && request.resource.data.offer is string
          && request.resource.data.offer.size() < 20000;
        // A deleted (already answered) signal reads as empty instead of an error.
        allow read: if signedIn() && (resource == null || resource.data.uid == request.auth.uid || isGm(gameId));
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isGm(gameId));
        allow update: if isGm(gameId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["answer"])
          && request.resource.data.answer is string
          && request.resource.data.answer.size() < 20000;
      }

      // One character per player. Party members can read it (allies' public info).
      // The player edits their own; the GM can edit any and is the only one who changes Rank. Parts
      // needing the GM's approval change only through the GM; the player's proposals wait in pendingEdits.
      match /characters/{uid} {
        allow read: if isMember(gameId);
        allow create: if isMember(gameId) && request.auth.uid == uid
          && request.resource.data.ownerId == uid
          && request.resource.data.rank == 9;
        // Players can't change their Combat Deck mid-combat (Act 6: edit decks while resting).
        allow update: if isGm(gameId)
          || (request.auth.uid == uid
              && request.resource.data.ownerId == uid
              && request.resource.data.rank == resource.data.rank
              && (playerMayEdit(gameId, "stats") || unchanged(["primary", "secondary"]))
              && (playerMayEdit(gameId, "inventory") || unchanged(["inventory", "ahn"]))
              && (playerMayEdit(gameId, "augment") || unchanged(["augment", "proficiencies"]))
              && (playerMayEdit(gameId, "equipment") || unchanged(["weapons", "armor", "deck", "ego"]))
              && (!inCombat(gameId)
                  || request.resource.data.get("deck", null) == resource.data.get("deck", null)));
        allow delete: if isGm(gameId) || (signedIn() && request.auth.uid == uid);
      }

      // The item library: players browse it to fill their inventories; the GM edits it. Players add
      // their own items and edit or delete only those. Unless the GM lets players make items (game
      // settings), a player's new or changed item is pending: it waits for the GM's approval, and a
      // player can't delete an approved one.
      match /items/{itemId} {
        allow read: if isMember(gameId);
        allow write: if isGm(gameId);
        allow create: if isMember(gameId)
          && request.resource.data.createdBy == request.auth.uid
          && (playersMakeItems(gameId) || request.resource.data.get("pending", false) == true);
        allow update: if isMember(gameId)
          && resource.data.get("createdBy", null) == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid
          && (playersMakeItems(gameId) || request.resource.data.get("pending", false) == true);
        allow delete: if isMember(gameId)
          && resource.data.get("createdBy", null) == request.auth.uid
          && (playersMakeItems(gameId) || resource.data.get("pending", false) == true);
      }

      // The effect library: Status effects, Passives, Proficiencies and Dice effects (shared/effects.ts).
      // Everyone in the game reads it; the GM edits it. Players add their own entries and edit or
      // delete only those. Unless the GM lets players make effects (game settings), a player's new or
      // changed effect isn't approved: the host ignores it until the GM approves it, and a player
      // can't delete an approved one.
      match /effects/{effectId} {
        allow read: if isMember(gameId);
        allow write: if isGm(gameId);
        allow create: if isMember(gameId)
          && request.resource.data.createdBy == request.auth.uid
          && (playersMakeEffects(gameId) || request.resource.data.get("approved", false) == false);
        allow update: if isMember(gameId)
          && resource.data.get("createdBy", null) == request.auth.uid
          && request.resource.data.createdBy == request.auth.uid
          && (playersMakeEffects(gameId) || request.resource.data.get("approved", false) == false);
        allow delete: if isMember(gameId)
          && resource.data.get("createdBy", null) == request.auth.uid
          && (playersMakeEffects(gameId) || resource.data.get("approved", false) == false);
      }

      // Enemy templates: only the GM sees or edits them.
      match /enemies/{templateId} {
        allow read, write: if isGm(gameId);
      }

      match /gm/meta {
        allow read: if isGm(gameId);
      }

      match /gm/notes {
        allow read: if isGm(gameId);
        allow write: if isGm(gameId)
          && request.resource.data.keys().hasOnly(["tokens"])
          && request.resource.data.tokens is map;
      }
    }
  }
}
