{
  "name": "solp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix functions install",
    "dev": "npm --prefix functions run build && concurrently -k -n firebase,web -c yellow,green \"npm:dev:emulators\" \"npm:dev:web\"",
    "dev:emulators": "firebase emulators:start --project demo-solp",
    "dev:web": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:functions": "npm --prefix functions run build",
    "typecheck": "tsc --noEmit && npm --prefix functions run typecheck",
    "deploy": "firebase deploy",
    "test:rules": "firebase emulators:exec --project demo-solp --only firestore,storage \"node --test tests/rules.test.ts\"",
    "test:engine": "node --test tests/engine.test.ts tests/ruleset.test.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "firebase-tools": "^15.32.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22"
  }
}
